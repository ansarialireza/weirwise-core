# Weirwise Core Development Configuration (.env.example)

# Environment
WEIRWISE_ENV=development
WEIRWISE_LOG_LEVEL=INFO

# Server
WEIRWISE_HOST=0.0.0.0
WEIRWISE_PORT=8000
WEIRWISE_SECRET_KEY=change-me-in-production-minimum-32-chars-long

# Database (PostgreSQL with pgvector extension)
WEIRWISE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/weirwise
WEIRWISE_DATABASE_SYNC_URL=postgresql://postgres:postgres@127.0.0.1:5432/weirwise
WEIRWISE_DB_POOL_SIZE=10
WEIRWISE_DB_MAX_OVERFLOW=20
WEIRWISE_DB_TIMEOUT_SECONDS=30

# File Storage
WEIRWISE_STORAGE_DIR=./var/data/storage
WEIRWISE_MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# Document Ingestion & Chunking
WEIRWISE_CHUNK_SIZE=500
WEIRWISE_CHUNK_OVERLAP=50

# Worker Settings
WEIRWISE_WORKER_POLL_INTERVAL=2.0
WEIRWISE_WORKER_CONCURRENCY=2
WEIRWISE_WORKER_MAX_RETRIES=3

# Embedding Provider (OpenAI-compatible)
WEIRWISE_EMBEDDING_BASE_URL=https://api.openai.com/v1
WEIRWISE_EMBEDDING_API_KEY=your-api-key-here
WEIRWISE_EMBEDDING_MODEL=text-embedding-3-small
WEIRWISE_EMBEDDING_DIMENSIONS=1536
WEIRWISE_EMBEDDING_TIMEOUT_SECONDS=30
WEIRWISE_EMBEDDING_BATCH_SIZE=64

# Chat Provider (OpenAI-compatible)
WEIRWISE_CHAT_BASE_URL=https://api.openai.com/v1
WEIRWISE_CHAT_API_KEY=your-api-key-here
WEIRWISE_CHAT_MODEL=gpt-4o-mini
WEIRWISE_CHAT_TIMEOUT_SECONDS=60
WEIRWISE_CHAT_MAX_TOKENS=1024
WEIRWISE_CHAT_TEMPERATURE=0.2
